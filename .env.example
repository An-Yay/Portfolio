# EmailJS — contact form delivery
# Copy this file to `.env.local` and fill in your values.
# Get these from https://dashboard.emailjs.com
#
# Note: Vite inlines VITE_* vars into the client bundle at build time.
# The EmailJS *public* key is designed to be public, but lock the service
# down in the EmailJS dashboard: restrict allowed origins to your domain
# and enable rate limiting, otherwise the endpoint can be abused.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Spotify now-playing (optional)
# Spotify requires a server-held refresh token, so the browser can't call it
# directly. Deploy the handler in scripts/spotify-now-playing.example.js as a
# serverless function and point this at its URL. Leave blank to hide the widget.
VITE_NOWPLAYING_URL=
